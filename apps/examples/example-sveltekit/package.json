{
  "name": "example-sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3113",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3113",
    "start": "node build"
  },
  "dependencies": {
    "@shadergradient/core": "file:./shadergradient-core-0.1.0.tgz",
    "@shadergradient/svelte": "file:./shadergradient-svelte-0.1.0.tgz",
    "@threlte/core": "8.6.1",
    "svelte": "5.57.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.16.1",
    "@types/three": "0.186.0",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}

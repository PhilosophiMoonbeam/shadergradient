{
  "name": "@shadergradient/svelte",
  "version": "0.1.0",
  "description": "Native Svelte 5 and Threlte ShaderGradient primitives",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "ShaderGradient contributors",
  "files": ["dist", "LICENSE", "BUILD-CONTRACT.md"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input src/lib --output dist --tsconfig ./tsconfig.json",
    "dev": "svelte-package --watch --input src/lib --output dist --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --plugin=prettier-plugin-svelte --write \"src/lib/**/*.{ts,svelte}\"",
    "format:check": "prettier --plugin=prettier-plugin-svelte --check \"src/lib/**/*.{ts,svelte}\""
  },
  "dependencies": {
    "@shadergradient/core": "workspace:^",
    "camera-controls": "2.9.0"
  },
  "peerDependencies": {
    "@threlte/core": "8.6.1",
    "svelte": ">=5.40.0 <=5.57.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@threlte/core": "8.6.1",
    "@types/three": "0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}

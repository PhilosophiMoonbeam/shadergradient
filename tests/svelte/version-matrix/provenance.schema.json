{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical pre-extraction fixture provenance",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "builtAt",
    "node",
    "sources",
    "output",
    "finalCoreCertified",
    "finalNativeCertified"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "enum": ["canonical-pre-extraction-fixture", "canonical-public-core-fixture"]
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "node": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object"
    },
    "finalCoreCertified": {
      "const": false
    },
    "finalNativeCertified": {
      "const": false
    }
  },
  "additionalProperties": false
}
